{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Youtube Music",
  "mainBinaryName": "YoutubeMusic",
  "version": "2.1.0",
  "identifier": "dev.ytmdesktop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Youtube Music",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
