{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mini",
  "description": "The small always-on-top player: playback controls, switching back to the full window, and dragging.",
  "windows": ["mini"],
  "permissions": [
    "core:default",
    "allow-player-call",
    "allow-toggle-mini",
    "allow-show-main-window",
    "core:window:allow-start-dragging"
  ]
}
